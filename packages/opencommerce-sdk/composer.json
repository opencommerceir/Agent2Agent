{
    "name": "opencommerce/sdk",
    "description": "PHP SDK for the OpenCommerce Platform MCP Gateway — lets AI Agents discover and execute platform capabilities.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "OpenCommerce\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenCommerce\\SDK\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
