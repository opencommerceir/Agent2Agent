APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Phase 4 Stage 8 (Performance Optimization, §7.20) recommends Redis for
# CacheService's own hot reads (Product/KPI caching, §7.20) — set
# CACHE_STORE=redis for a real deployment with a Redis server available.
# Stays `database` here so a fresh `composer install && php artisan serve`
# works with zero extra infrastructure to stand up first.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Opt-in only (Phase 4 Stage 8, §7.20) — see config/database.php's own
# comment for the real correctness risk (session/transaction state
# leaking across unrelated requests in a multi-tenant app) before
# enabling this in production.
DB_PERSISTENT_CONNECTIONS=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_CURRENCY=USD
WOOCOMMERCE_TIMEOUT=10

# Agent Orchestrator — LLM-based Planner (Phase 6, Stage 3, §7.28).
# PLANNER_TYPE stays `deterministic` here on purpose — a fresh
# `composer install` has no real OPENAI_API_KEY/CLAUDE_API_KEY, and
# defaulting to `llm` would mean every /api/agents/* call attempts a
# real, keyless network request before silently falling back (same
# "safe default for local dev, real infra opted into explicitly"
# reasoning WOOCOMMERCE_*/CACHE_STORE above already follow). Set
# PLANNER_TYPE=llm once real credentials for LLM_PROVIDER exist below.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-opus-20240229

# OpenRouter (Showcase prep, §7.32) — a single API in front of 100+
# models, several genuinely free (the default model below costs nothing
# to call). Set LLM_PROVIDER=openrouter to use it instead of openai/claude.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-405b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

PLANNER_TYPE=deterministic
PLANNER_FALLBACK_TO_DETERMINISTIC=true

# Agent Orchestrator — Self-Reflection & Reasoning (Phase 6, Stage 6,
# §7.31). Same "safe default, explicit opt-in for real network calls"
# reasoning as PLANNER_TYPE above — REASONING_TYPE stays `simple` here on
# purpose.
REASONING_TYPE=simple
REASONING_FALLBACK_TO_SIMPLE=true
